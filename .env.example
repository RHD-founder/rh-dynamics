# ==============================================================================
# RH-Dynamics Environment Variables Template
# Copy this file to .env.local for local development or set these in production
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Brevo Transactional SMTP Configuration (Email Delivery)
# ------------------------------------------------------------------------------
# How to get your Brevo SMTP Keys:
# 1. Log in to https://app.brevo.com
# 2. Click your Profile / Organization name at top-right -> Click "SMTP & API"
# 3. Select the "SMTP" tab (NOT the API tab)
# 4. Copy your Login into SMTP_USER and click "Generate a new SMTP key" for SMTP_PASSWORD
#
# IMPORTANT: In Brevo, go to "Senders, Domains & Dedicated IPs" -> "Senders"
# and ensure "support@rhdynamics.in" is added and verified as an authorized sender!

SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-brevo-login-email@domain.com
SMTP_PASSWORD=your-brevo-smtp-key-here

# Email Sender & Admin Recipient (Optional overrides)
SMTP_FROM=RH-Dynamics <support@rhdynamics.in>
ADMIN_NOTIFICATION_EMAIL=founder@rhdynamics.in

# ------------------------------------------------------------------------------
# 2. Anti-Bot Security System
# ------------------------------------------------------------------------------
# The contact form utilizes our native, zero-cost 6-layer defense engine:
# - Multi-Vector Invisible Honeypots
# - Time-Trap Velocity Check (>= 3.0 seconds)
# - Heuristic Link Density & Markup Injection Parser
# - Built-in DNS MX Email Verification (via node:dns/promises)
# - Persistent Bot Blocklist with Silent Blackholing
# Zero external CAPTCHA keys or subscriptions required!

# ------------------------------------------------------------------------------
# 3. Supabase Database Configuration (Optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
